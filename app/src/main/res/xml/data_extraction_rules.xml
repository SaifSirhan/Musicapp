<?xml version="1.0" encoding="utf-8"?><!--
   Backup / device-transfer rules for API 31+.
   The library database, favorites and settings are backed up. Downloaded audio
   lives under filesDir/externalFilesDir/downloads, which is NOT included below,
   so it is never backed up (an <include> list is an allowlist).
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
