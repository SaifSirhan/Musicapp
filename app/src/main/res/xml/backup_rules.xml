<?xml version="1.0" encoding="utf-8"?><!--
   Auto Backup rules for API < 31.
   The library database, favorites and settings are backed up. Downloaded audio
   lives under filesDir/externalFilesDir/downloads, which is NOT included below,
   so it is never backed up (an <include> list is an allowlist).
   See https://developer.android.com/guide/topics/data/autobackup
-->
<full-backup-content>
    <include domain="database" path="." />
    <include domain="sharedpref" path="." />
</full-backup-content>
